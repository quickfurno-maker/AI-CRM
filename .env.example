NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=postgresql://crm_ai:crm_ai_dev@localhost:15432/crm_ai
REDIS_URL=redis://localhost:16379
EVENT_STREAM=crm-ai:events
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
PLATFORM_SECRET_ENCRYPTION_KEY=replace-with-a-separate-at-least-32-random-character-key
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:4000
WEB_APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000/v1
META_TRANSPORT_MODE=disabled
META_GRAPH_VERSION=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_PROVIDER_BUSINESS_ID=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Per-channel tokens are referenced by name, e.g. env:META_WA_TOKEN_ACME
META_WA_TOKEN_ACME=
AI_TRANSPORT_MODE=disabled
OPENAI_API_KEY=
AI_OPENAI_FAST_MODEL=gpt-6-luna
AI_OPENAI_REASONING_MODEL=gpt-6.1-sol
AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EVENT_STREAM=crm-ai:events
AI_WHATSAPP_EVENT_CONSUMER_ENABLED=false
AI_WHATSAPP_CONSUMER_GROUP=crm-ai:ai-whatsapp
AUTOMATION_EVENT_CONSUMER_ENABLED=false
AUTOMATION_CONSUMER_GROUP=crm-ai:automation
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_POLL_MS=1000

# SaaS payment gateway. Keep disabled until provider credentials/webhook are configured.
SAAS_PAYMENT_MODE=disabled
SAAS_PAYMENT_PROVIDER=razorpay
SAAS_PAYMENT_ALLOWED_CURRENCIES=INR
SAAS_PAYMENT_TEST_SECRET=dev-payment-test-secret-change-before-production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Reverse-proxy topology. Default 1 = direct trusted ALB hop.
# Use 2 for Cloudflare -> ALB only after ALB ingress is restricted to Cloudflare.
TRUST_PROXY_HOPS=1

# Distributed API rate limiting (Redis with bounded in-memory fallback)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SESSION_PER_MINUTE=600
RATE_LIMIT_EXTERNAL_PER_MINUTE=300
RATE_LIMIT_WEBHOOK_PER_MINUTE=1200
