# Copy to .env.production on the VPS and chmod 600.
# Never commit the real file.

NODE_ENV=production

# Supabase PostgreSQL.
# For an IPv4-only VPS use Supavisor session mode on port 5432.
# Append sslmode=require at minimum.
DATABASE_URL='postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require'
MIGRATION_DATABASE_URL='postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require'
DATABASE_POOL_MAX=8
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
WORKER_DATABASE_POOL_MAX=4

# Private Redis inside Docker.
REDIS_PASSWORD=CHANGE_TO_A_LONG_RANDOM_SECRET
EVENT_STREAM=crm-ai:events

# Authentication and encryption.
JWT_ACCESS_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
PLATFORM_SECRET_ENCRYPTION_KEY=CHANGE_TO_A_DIFFERENT_32_PLUS_CHARACTER_SECRET
JWT_ACCESS_TTL_SECONDS=900

# Public origins. Replace only during final domain activation.
CORS_ORIGINS=https://app.example.com
PUBLIC_API_ORIGIN=https://api.example.com
WEB_APP_ORIGIN=https://app.example.com
TRUST_PROXY_HOPS=1

# Live integrations stay disabled until external activation.
META_TRANSPORT_MODE=disabled
META_GRAPH_VERSION=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_PROVIDER_BUSINESS_ID=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WA_TOKEN_ACME=

AI_TRANSPORT_MODE=disabled
OPENAI_API_KEY=
AI_OPENAI_FAST_MODEL=gpt-6-luna
AI_OPENAI_REASONING_MODEL=gpt-6.1-sol
AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_WHATSAPP_EVENT_CONSUMER_ENABLED=false
AI_WHATSAPP_CONSUMER_GROUP=crm-ai:ai-whatsapp

AUTOMATION_EVENT_CONSUMER_ENABLED=false
AUTOMATION_CONSUMER_GROUP=crm-ai:automation
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_POLL_MS=1000

SAAS_PAYMENT_MODE=disabled
SAAS_PAYMENT_PROVIDER=razorpay
SAAS_PAYMENT_ALLOWED_CURRENCIES=INR
SAAS_PAYMENT_TEST_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SESSION_PER_MINUTE=600
RATE_LIMIT_EXTERNAL_PER_MINUTE=300
RATE_LIMIT_WEBHOOK_PER_MINUTE=1200

# Host bindings used by Docker Compose and host Nginx.
WEB_BIND_PORT=3000
API_BIND_PORT=4000
